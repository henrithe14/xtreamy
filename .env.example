# Copie este arquivo para .env.local e preencha os valores.
# Nunca coloque valores reais neste arquivo: ele vai para o repositório.

# Supabase (Painel → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Cloud (Painel → Settings → Keys) — usado a partir da Etapa 3
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Endereço público do app (em produção: https://seu-dominio)
APP_BASE_URL=http://localhost:3000

# OAuth do YouTube (Destino) — usado a partir da Etapa 5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave para criptografar refresh tokens do Google no banco — usada a partir da Etapa 5
TOKEN_ENCRYPTION_KEY=
